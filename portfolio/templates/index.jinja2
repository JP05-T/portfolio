{% extends "base.jinja2" %}

{% block content %}
<header id="home" class="hero text-center">
    <div class="container">
        <h1 class="display-4 fw-bold">{{ name }}</h1>
        <p class="lead">{{ tagline }}</p>
        <p class="mx-auto" style="max-width: 600px;">{{ profile }}</p>
        <a href="#contact" class="btn btn-light btn-lg mt-2">Get in Touch</a>
    </div>
</header>

<section id="education" class="py-5">
    <div class="container">
        <h2 class="text-center mb-4">Education</h2>
        <div class="row g-4">
            {% for item in education %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">{{ item.degree }}</h5>
                        <h6 class="text-primary">{{ item.school }}</h6>
                        <p class="text-muted small mb-2"><i class="bi bi-calendar3"></i> {{ item.years }}</p>
                        <p class="card-text">{{ item.details }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section id="skills" class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-4">Skills</h2>
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                {% for skill in skills %}
                <span class="badge rounded-pill text-bg-primary fs-6 px-3 py-2 m-1">{{ skill }}</span>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<section id="projects" class="py-5">
    <div class="container">
        <h2 class="text-center mb-4">Projects</h2>
        <div class="row g-4">
            {% for item in projects %}
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    {% if item.image %}
                    <img src="{{ 'static/' ~ item.image }}" alt="{{ item.title }}" class="card-img-top project-thumb" loading="lazy">
                    {% endif %}
                    <div class="card-body">
                        <i class="bi bi-code-slash display-5 text-primary"></i>
                        <h5 class="card-title mt-2">{{ item.title }}</h5>
                        <h6 class="text-primary small">{{ item.tech }}</h6>
                        <p class="card-text">{{ item.details }}</p>
                        {% if item.demo %}<a href="{{ item.demo }}" class="btn btn-sm btn-outline-primary" target="_blank">Live Demo <i class="bi bi-box-arrow-up-right"></i></a>{% endif %}
                        {% if item.url %}<a href="{{ item.url }}" class="btn btn-sm btn-outline-secondary" target="_blank">View Code <i class="bi bi-box-arrow-up-right"></i></a>{% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section id="certifications" class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-4">Certifications</h2>
        <div class="row g-4">
            {% for cert in certifications %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <a href="{{ 'static/' ~ cert.image }}" target="_blank" data-bs-toggle="modal" data-bs-target="#certModal" data-cert-img="{{ 'static/' ~ cert.image }}" class="text-decoration-none">
                        <img src="{{ 'static/' ~ cert.image }}" alt="{{ cert.title }}" class="card-img-top cert-thumb" loading="lazy">
                    </a>
                    <div class="card-body">
                        <h6 class="card-title mb-1">{{ cert.title }}</h6>
                        <p class="text-muted small mb-2">{{ cert.issuer }} &middot; {{ cert.date }}</p>
                        <a href="{{ 'static/' ~ cert.image }}" class="btn btn-sm btn-outline-primary" download>Download</a>
                        {% if cert.url %}<a href="{{ cert.url }}" class="btn btn-sm btn-outline-secondary" target="_blank">Verify</a>{% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Certificate lightbox modal -->
<div class="modal fade" id="certModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Certificate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="certModalImg" src="" alt="Certificate" class="img-fluid">
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('[data-cert-img]').forEach(function (el) {
        el.addEventListener('click', function (e) {
            e.preventDefault();
            document.getElementById('certModalImg').src = this.dataset.certImg;
        });
    });
</script>

<section id="contact" class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-4">Contact</h2>
        <p class="text-center text-muted"><i class="bi bi-translate"></i> Languages: {{ languages | join(", ") }}</p>
        <div class="row justify-content-center text-center g-3">
            <div class="col-md-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-envelope display-6 text-primary"></i>
                        <p class="mt-2 mb-0"><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-telephone display-6 text-primary"></i>
                        <p class="mt-2 mb-0">{{ contact.phone }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-github display-6 text-primary"></i>
                        <p class="mt-2 mb-0"><a href="{{ contact.github }}" target="_blank">GitHub</a></p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-linkedin display-6 text-primary"></i>
                        <p class="mt-2 mb-0"><a href="{{ contact.linkedin }}" target="_blank">LinkedIn</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
