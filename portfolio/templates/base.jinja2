<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ name }} | JP MCA Student - Python Developer Portfolio{% endblock %}</title>
    <meta name="description" content="Official portfolio of {{ name }} (JP MCA), MCA student and Python developer. Explore education, projects, skills, and certifications including CardioAI - Heart Disease Prediction System.">
    <meta name="keywords" content="JP MCA, jpmca, Jaya Prakash T, Jaya Prakash, MCA student, Python developer, heart disease prediction, CardioAI, Sri Manakula Vinayagar Engineering College, Puducherry">
    <meta name="author" content="{{ name }}">
    <meta name="robots" content="index, follow">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ name }} | JP MCA Student - Python Developer Portfolio">
    <meta property="og:description" content="Official portfolio of {{ name }} (JP MCA), MCA student and Python developer. Education, projects, skills, and certifications.">
    <meta property="og:url" content="{{ site_url }}">
    <meta property="og:site_name" content="{{ name }} Portfolio">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ name }} | MCA Student - Python Developer Portfolio">
    <meta name="twitter:description" content="Official portfolio of {{ name }}, MCA student and Python developer.">
    <link rel="canonical" href="{{ site_url }}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>&#128104;&#8205;&#128187;</text></svg>">
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "{{ name }}",
        "email": "mailto:{{ contact.email }}",
        "telephone": "{{ contact.phone }}",
        "url": "{{ site_url }}",
        "sameAs": [
            "{{ contact.linkedin }}",
            "{{ contact.github }}"
        ],
        "jobTitle": "MCA Student",
        "alumniOf": "Sri Manakula Vinayagar Engineering College",
        "knowsAbout": ["Python", "Django", "Machine Learning", "Web Development", "Oracle SQL"]
    }
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { padding-top: 56px; }
        .hero { background: linear-gradient(135deg, #0d6efd, #6f42c1); color: #fff; padding: 5rem 0; }
        .skill-bar { height: 8px; }
        section { scroll-margin-top: 70px; }
        .card { transition: transform .2s ease; }
        .card:hover { transform: translateY(-4px); }
        .cert-thumb { object-fit: cover; height: 160px; border-bottom: 1px solid rgba(0,0,0,.125); }
        .project-thumb { object-fit: cover; height: 180px; border-bottom: 1px solid rgba(0,0,0,.125); }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="#home">{{ name }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#education">Education</a></li>
                    <li class="nav-item"><a class="nav-link" href="#skills">Skills</a></li>
                    <li class="nav-item"><a class="nav-link" href="#projects">Projects</a></li>
                    <li class="nav-item"><a class="nav-link" href="#certifications">Certifications</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                </ul>
            </div>
        </div>
    </nav>

    {% block content %}{% endblock %}

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            &copy; {{ current_year }} {{ name }}. Built with Pyramid &amp; Bootstrap.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
